# Supabase configuration
# Nusqan (copy) this file to .env and fill in your real values.

# 1. Supabase Project URL
#    Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# 2. Anon public key (safe to expose in frontend)
#    Dashboard -> Project Settings -> API -> anon public
SUPABASE_ANON_KEY=eyJhbGciOi...

# 3. Service role key (SECRET - do not share, backend only)
#    Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# 4. PostgreSQL connection string
#    Dashboard -> Project Settings -> Database -> Connection string (SQLAlchemy)
#    Format: postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#    NOTE: replace the password with your actual database password.
DATABASE_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres